{
  "name": "app-proxy",
  "arn": "arn:aws:rds:ap-northeast-1:111122223333:db-proxy:prx-ABCDEFGHIJKLMNOPQRSTU",
  "engine_family": "POSTGRESQL",
  "endpoint": "app-proxy.proxy-example.ap-northeast-1.rds.amazonaws.com",
  "require_tls": true,
  "idle_client_timeout": 1800,
  "default_auth_scheme": "NONE",
  "role_arn": "arn:aws:iam::111122223333:role/app-rds-proxy",
  "vpc_id": "vpc-0123456789abcdef0",
  "subnet_ids": ["subnet-0123456789abcdef0", "subnet-0123456789abcdef1"],
  "security_group_ids": ["sg-0123456789abcdef4"],
  "auth": [
    {
      "auth_scheme": "SECRETS",
      "username": "app_user",
      "client_password_auth_type": "POSTGRES_SCRAM_SHA_256",
      "iam_auth": "REQUIRED",
      "secret_arn": "arn:aws:secretsmanager:ap-northeast-1:111122223333:secret:app/database-example"
    }
  ]
}
