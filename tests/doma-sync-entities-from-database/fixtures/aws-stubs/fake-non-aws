#!/usr/bin/python3
import os
import sys
from pathlib import Path


AWS_ENVIRONMENT_NAMES = (
    "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "AWS_SECURITY_TOKEN",
    "AWS_ACCESS_KEY", "AWS_SECRET_KEY", "AWS_WEB_IDENTITY_TOKEN_FILE", "AWS_ROLE_ARN",
    "AWS_ROLE_SESSION_NAME", "AWS_SHARED_CREDENTIALS_FILE", "AWS_CONFIG_FILE", "AWS_PROFILE",
    "AWS_DEFAULT_PROFILE", "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI",
    "AWS_CONTAINER_CREDENTIALS_FULL_URI", "AWS_CONTAINER_AUTHORIZATION_TOKEN",
    "AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE",
)


name = Path(sys.argv[0]).name
is_aws_interpreter = name == "python3" and len(sys.argv) > 1 and Path(sys.argv[1]).name == "aws"
if name == "python3":
    source = sys.argv[2] if len(sys.argv) > 2 and sys.argv[1] == "-c" else ""
    label = "python|redactor" if "DOMA_REDACT_PASSWORD" in source else "python|helper"
else:
    label = name

if os.environ.get("FAKE_INSTRUMENT_NON_AWS") == "true" and not is_aws_interpreter:
    values = [os.environ[name] for name in AWS_ENVIRONMENT_NAMES if os.environ.get(name)]
    event = "non-aws-env-clean|" + label
    if values:
        event = "non-aws-env-leak|" + label + "|" + "|".join(values)
    with open(os.environ["FAKE_CALL_LOG"], "a", encoding="utf-8") as handle:
        handle.write(event + "\n")

real_command = os.environ["FAKE_REAL_COMMAND_" + name.upper()]
os.execv(real_command, [real_command, *sys.argv[1:]])
