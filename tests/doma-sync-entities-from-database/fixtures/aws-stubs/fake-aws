#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path


args = sys.argv[1:]
if len(args) >= 2 and args[0] == "--profile":
    if os.environ.get("EXPECTED_AWS_PROFILE") and args[1] != os.environ["EXPECTED_AWS_PROFILE"]:
        raise SystemExit(94)
    args = args[2:]
if len(args) < 2:
    raise SystemExit(90)
service, operation = args[:2]
if os.environ.get("FAKE_REQUIRE_AWS_ENV") == "true":
    required = (
        "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "AWS_SECURITY_TOKEN",
        "AWS_ACCESS_KEY", "AWS_SECRET_KEY", "AWS_WEB_IDENTITY_TOKEN_FILE", "AWS_ROLE_ARN",
        "AWS_ROLE_SESSION_NAME", "AWS_SHARED_CREDENTIALS_FILE", "AWS_CONFIG_FILE", "AWS_PROFILE",
        "AWS_DEFAULT_PROFILE", "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI",
        "AWS_CONTAINER_CREDENTIALS_FULL_URI", "AWS_CONTAINER_AUTHORIZATION_TOKEN",
        "AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE",
    )
    if any(not os.environ.get(name) for name in required):
        raise SystemExit(95)
allowed = {
    ("sts", "get-caller-identity"),
    ("rds", "describe-db-instances"),
    ("rds", "describe-db-clusters"),
    ("rds", "describe-db-proxies"),
    ("rds", "describe-db-proxy-targets"),
    ("secretsmanager", "describe-secret"),
    ("secretsmanager", "get-secret-value"),
    ("rds", "generate-db-auth-token"),
}
if (service, operation) not in allowed:
    raise SystemExit(93)
secret_values = (os.environ.get("FAKE_SECRET_PASSWORD", ""), os.environ.get("FAKE_IAM_TOKEN", ""))
if any(value and any(value in arg for arg in args) for value in secret_values):
    raise SystemExit(91)
with open(os.environ["FAKE_CALL_LOG"], "a", encoding="utf-8") as handle:
    handle.write("aws|" + "|".join(args) + "\n")
    if os.environ.get("FAKE_REQUIRE_AWS_ENV") == "true":
        handle.write("aws-credential-env-present|" + service + "|" + operation + "\n")

fixtures = Path(os.environ["FAKE_AWS_FIXTURES"])
scenario = os.environ.get("FAKE_AWS_SCENARIO", "instance")
if (service, operation) == ("sts", "get-caller-identity"):
    print(json.dumps({"Account": os.environ.get("FAKE_AWS_ACCOUNT", "123456789012")}))
elif operation == "describe-db-instances":
    print((fixtures / "instance.json").read_text(encoding="utf-8"), end="")
elif operation == "describe-db-clusters":
    if "app-pg-cluster" in args:
        print((fixtures / "cluster-postgresql.json").read_text(encoding="utf-8"), end="")
    else:
        print((fixtures / "cluster.json").read_text(encoding="utf-8"), end="")
elif operation == "describe-db-proxies":
    print((fixtures / "proxy.json").read_text(encoding="utf-8"), end="")
elif operation == "describe-db-proxy-targets":
    if os.environ.get("FAKE_PROXY_TARGETS_MIXED_INVALID") == "true":
        print(json.dumps({"Targets": [
            {"RdsResourceId": "app-instance", "Type": "RDS_INSTANCE"},
            {"RdsResourceId": "unexpected", "Type": "UNSUPPORTED"},
        ]}))
    elif os.environ.get("FAKE_PROXY_TRACKED_CLUSTER") == "true":
        print(json.dumps({"Targets": [
            {"RdsResourceId": "app-pg-cluster", "Type": "TRACKED_CLUSTER"},
            {"RdsResourceId": "app-instance", "Type": "RDS_INSTANCE"},
        ]}))
    else:
        print((fixtures / "proxy-targets.json").read_text(encoding="utf-8"), end="")
elif operation == "describe-secret":
    print((fixtures / "secret-description.json").read_text(encoding="utf-8"), end="")
elif operation == "get-secret-value":
    secret = {"username": os.environ["FAKE_SECRET_USERNAME"], "password": os.environ["FAKE_SECRET_PASSWORD"], "dbname": "appdb"}
    if os.environ.get("FAKE_SECRET_HOST"):
        secret["host"] = os.environ["FAKE_SECRET_HOST"]
    print(json.dumps({"SecretString": json.dumps(secret)}))
elif operation == "generate-db-auth-token":
    print(os.environ["FAKE_IAM_TOKEN"])
