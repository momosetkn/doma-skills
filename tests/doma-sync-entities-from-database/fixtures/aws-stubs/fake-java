#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path


AWS_CREDENTIAL_NAMES = (
    "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "AWS_SECURITY_TOKEN",
    "AWS_ACCESS_KEY", "AWS_SECRET_KEY", "AWS_WEB_IDENTITY_TOKEN_FILE", "AWS_ROLE_ARN",
    "AWS_ROLE_SESSION_NAME", "AWS_SHARED_CREDENTIALS_FILE", "AWS_CONFIG_FILE", "AWS_PROFILE",
    "AWS_DEFAULT_PROFILE", "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI",
    "AWS_CONTAINER_CREDENTIALS_FULL_URI", "AWS_CONTAINER_AUTHORIZATION_TOKEN",
    "AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE",
)


with open(os.environ["FAKE_CALL_LOG"], "a", encoding="utf-8") as handle:
    handle.write("java|" + "|".join(sys.argv[1:]) + "\n")
if os.environ.get("FAKE_LEAK_AWS_ENV") == "true":
    values = [os.environ[name] for name in AWS_CREDENTIAL_NAMES if os.environ.get(name)]
    with open(os.environ["FAKE_CALL_LOG"], "a", encoding="utf-8") as handle:
        if values:
            leaked = "|".join(values)
            handle.write("aws-env-leak|java|snapshot|" + leaked + "\n")
            print("aws-stdout=" + leaked)
            print("aws-stderr=" + leaked, file=sys.stderr)
        else:
            handle.write("aws-env-clean|java|snapshot\n")
expected = {
    "DOMA_CODEGEN_DB_URL": "EXPECTED_DB_URL",
    "DOMA_CODEGEN_DB_USER": "EXPECTED_DB_USER",
    "DOMA_CODEGEN_DB_PASSWORD": "EXPECTED_DB_PASSWORD",
}
if any(os.environ.get(actual) != os.environ.get(wanted) for actual, wanted in expected.items()):
    print("credential environment mismatch", file=sys.stderr)
    raise SystemExit(92)
expected_scope = {
    "DOMA_CODEGEN_DB_SCHEMA": "EXPECTED_DB_SCHEMA",
    "DOMA_CODEGEN_DB_CATALOG": "EXPECTED_DB_CATALOG",
    "DOMA_CODEGEN_TABLE_PATTERN": "EXPECTED_TABLE_PATTERN",
}
if any(
    os.environ.get(wanted) is not None
    and os.environ.get(actual) != os.environ.get(wanted)
    for actual, wanted in expected_scope.items()
):
    print("metadata scope mismatch", file=sys.stderr)
    raise SystemExit(93)
output = Path(os.environ["DOMA_CODEGEN_SCHEMA_SNAPSHOT"])
output.parent.mkdir(parents=True, exist_ok=True)
content = os.environ.get("FAKE_SNAPSHOT_SECRET")
if content is None:
    content = json.dumps({"format_version": 1, "database": os.environ["DOMA_CODEGEN_DB_KIND"], "tables": []})
output.write_text(content + "\n", encoding="utf-8")
if os.environ.get("FAKE_JAVA_EXIT"):
    raise SystemExit(int(os.environ["FAKE_JAVA_EXIT"]))
if os.environ.get("FAKE_LEAK_OUTPUT") == "true":
    print("stdout=" + os.environ["DOMA_CODEGEN_DB_PASSWORD"])
    print("stderr=" + os.environ["DOMA_CODEGEN_DB_PASSWORD"], file=sys.stderr)
